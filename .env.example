# Database dashboard
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Database sumber CR/B
SUMBER_DB_HOST=127.0.0.1
SUMBER_DB_PORT=3306
SUMBER_DB_USER=
SUMBER_DB_PASSWORD=
SUMBER_DB_NAME=

# Folder simpan gambar halaman
UPLOAD_DIR=uploads

# ID server untuk IdGenerator (2 digit). Wajib beda untuk tiap server/instance aplikasi
# yang menulis ke database yang sama agar ID tidak bentrok.
SERVER_ID=01

# ID server khusus script (db:seed, db:migrasi-id); dibedakan dari aplikasi. Default 99.
SCRIPT_SERVER_ID=99

# Template URL halaman CR/B di website webfuzo (placeholder {nomor} = nomor sumber apa adanya).
# Kosongkan salah satunya untuk menyembunyikan tombol "Lihat dokumen" pada tipe itu.
WEBFUZO_URL_CR=https://appdk-trial.duakelinci.id:9393/webfuzo/web/index.php?r=cr%2Fcr%2Fview&nomer={nomor}
WEBFUZO_URL_B=https://appdk-trial.duakelinci.id:9393/webfuzo/web/index.php?r=cr%2Fmonitoring-bugs%2Fview&nomer={nomor}

# CATATAN (bukan variabel yang dibaca dari berkas ini): bila URL beta/live memakai CA internal yang tidak
# ada di daftar CA bawaan Node, health akan melaporkan "Rantai sertifikat tidak lengkap atau tidak cocok".
# Atur NODE_EXTRA_CA_CERTS=<path file CA .pem> sebagai environment PROSES saat menjalankan aplikasi
# (shell / process manager). Node membacanya saat start, jadi menaruhnya di .env TIDAK berfungsi.
